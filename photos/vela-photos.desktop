[Desktop Entry]
Type=Application
Name=Photos
Name[tr]=Fotoğraflar
GenericName=Image Viewer
GenericName[tr]=Resim Görüntüleyici
Comment=View your pictures
Comment[tr]=Resimlerini görüntüle
Exec=vela-photos %f
Icon=image-viewer
Categories=Graphics;Viewer;
MimeType=image/jpeg;image/png;image/gif;image/webp;image/bmp;image/svg+xml;image/tiff;image/x-icon;image/avif;
Keywords=photo;picture;image;viewer;
StartupNotify=true
