[Desktop Entry]
Type=Application
Name=Notepad
Name[tr]=Not Defteri
GenericName=Text Editor
GenericName[tr]=Metin Düzenleyici
Comment=View and edit plain text files
Comment[tr]=Düz metin dosyalarını görüntüle ve düzenle
