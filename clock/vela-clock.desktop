[Desktop Entry]
Type=Application
Name=Clock
Name[tr]=Saat
Name[it]=Orologio
GenericName=Alarms & Clock
GenericName[tr]=Alarmlar ve Saat
GenericName[it]=Sveglie e orologio
Comment=Timers, alarms, stopwatch and world clocks
Comment[tr]=Zamanlayıcılar, alarmlar, kronometre ve dünya saatleri
